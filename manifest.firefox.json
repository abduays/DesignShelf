{
  "manifest_version": 3,
  "name": "DesignShelf - Visual Component Collector",
  "version": "0.8.3",
  "description": "Inspect, capture and organise website components locally. No account or remote service.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "Open DesignShelf",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "designshelf@example.local",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "sidebar_action": {
    "default_title": "DesignShelf",
    "default_panel": "sidebar.html",
    "open_at_install": false
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
