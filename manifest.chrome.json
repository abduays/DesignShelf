{
  "manifest_version": 3,
  "name": "DesignShelf - Visual Component Collector",
  "version": "0.8.3",
  "description": "Inspect, capture and organise website components locally. No account or remote service.",
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "action": {
    "default_title": "Open DesignShelf",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidebar.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "114"
}
